{
  "name": "@enzitag/optima-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Interface compartilhada do EnziTAG Optima (navegador e Windows/Tauri)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "check:contracts": "node scripts/gen-contracts.mjs --check",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/host-grotesk": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "i18next": "26.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
