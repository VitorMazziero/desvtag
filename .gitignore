# Acervo e registro histórico locais; preservar no computador.
# A pasta plans/ saiu do repositório (DT-0001); a regra abaixo mantém o registro local fora do Git.
/referencias/
/plans/conversa_rust_doe_estatistica.md
/.local/

# Rust e WebAssembly.
**/target/
**/pkg/
/app/crates/*/bindings/

# Interface e arquivos gerados.
**/node_modules/
**/dist/
**/.vite/
**/.next/
**/coverage/
**/test-results/
**/playwright-report/

# Ferramentas usadas apenas como referência de validação.
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
*.pyc

# Configurações e credenciais locais.
.env
.env.*
!.env.example
credentials*.json
client_secret*.json
token*.json
*.pem
*.key
*.p12
*.pfx

# Arquivos temporários e configurações pessoais.
*.log
*.tmp
*.bak
*.swp
*.swo
*.code-workspace
**/.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Cola WASM gerada por app/web/scripts/build-wasm.mjs.
/app/web/src/services/engine/wasm/

# Esquemas gerados pelo Tauri durante a compilação.
/app/desktop/src-tauri/gen/

# Dados reais do exemplo kLa: só na máquina do usuário até a autorização de distribuição (PD-16)
examples/05-kLa/

# Saídas locais das avaliações por rodada (somente evidências selecionadas são versionadas).
/app/web/test-results-*/

# Rodadas ET24 transferidas para o acervo privado.
/docs/imagens/evidencias-v0.4-et24/ui-matrix-accepted/
/docs/imagens/evidencias-v0.4-et24/matrix-firefox-webkit/

# Evidências brutas da v0.4 ficam no acervo externo. Os índices existentes são versionados.
/docs/imagens/evidencias-v0.4-*/
/docs/imagens/auditoria-ux-v0.4-*/
